<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SPEC:R32: the device-id file stays out of Auto Backup (fullBackupContent, Android 11)
         and out of cloud backup and device transfer (dataExtractionRules, Android 12 on). -->
