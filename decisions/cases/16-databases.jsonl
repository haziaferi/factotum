# Contest 16: databases in pages. Each case is a function of the same id in tools/dbview_sim.py; the simulator's result overrides any hand mark.
# Survey with sources: decisions/16-databases-survey.json (Notion, Obsidian Bases, Anytype, Logseq, Capacities, 2026-10-05).
{"id": "tendril-db-is-page", "owner": "tendril", "given": "a database is a page in the tree, under another page", "when": "made", "then": "it is a page of kind database with a parent", "source": "Tendril data/page/Page.kt:21-35 (kind = DATABASE); Factotum SPEC §3.12 slice 12b (page_database makes a page a database)"}
{"id": "tendril-rows-are-subpages", "owner": "tendril", "given": "a row is made inside a database", "when": "made", "then": "it is a sub-page of the database page and a row", "source": "Tendril Page.kt:31 (databaseId); Factotum SPEC §3.12 'Rows are the database page's sub-pages'"}
{"id": "tendril-doorway-label", "owner": "tendril", "given": "a page elsewhere in the tree carries the database's doorway label", "when": "the database is read", "then": "the page is a row and keeps its own place", "source": "Tendril data/pagedatabase/PageDatabase.kt:45-52, domain/LabelMembership.kt:80; Factotum SPEC §3.12, ADR 08"}
{"id": "tendril-trash-db-trashes-owned-rows", "owner": "tendril", "given": "a database with an owned row and a labelled member", "when": "the database is trashed", "then": "the owned row goes with it; the labelled member stays", "source": "Factotum SPEC §3.12 'Trashing a database trashes its rows'; Tendril LabelMembership.kt unbind keeps native rows"}
{"id": "owner-inline-in-page", "owner": "owner", "given": "an ordinary page", "when": "a database is made inside it", "then": "it shows in place among the page's blocks", "source": "owner 2026-10-05: 'databases were supposed to belong within single pages, like in Notion'; Notion inline databases (survey Q2)"}
{"id": "owner-project-shows-its-tasks", "owner": "owner", "given": "a central Tasks database whose rows name their project", "when": "a project page shows Tasks", "then": "it shows only the rows naming this page", "source": "survey Q12: Obsidian Bases filter on `this`, Capacities 'This object', Notion linked view on a relation, Anytype inline query on a relation"}
{"id": "owner-same-page-two-places", "owner": "owner", "given": "one page", "when": "it is put into two databases", "then": "it is a row of both, one record", "source": "survey Q4: Anytype/Capacities collections, Obsidian and Logseq queries; Notion only through relations"}
{"id": "owner-one-db-many-places", "owner": "owner", "given": "one database shown in two pages with different filters", "when": "a row's value changes", "then": "each place reflects it under its own filter", "source": "survey Q5: Notion linked views, Anytype inline query blocks, Obsidian embedded base views"}
{"id": "owner-move-page-keeps-inline-db", "owner": "owner", "given": "a page with a database inside it", "when": "the page is moved", "then": "the database and its rows move with it and still show in place", "source": "survey Q6 (Notion: an inline database moves with its page)"}
{"id": "owner-trash-page-with-inline-db", "owner": "owner", "given": "a page whose inline database has an owned row and a labelled member", "when": "the page is trashed, then restored", "then": "the owned row goes and comes back; the member is untouched; the block shows both again", "source": "survey Q7 (Notion: restoring a page with an inline database restores its rows); Factotum SPEC §3.12 revive"}
{"id": "ref-query-by-property", "owner": "reference", "given": "pages anywhere in the tree with a status property", "when": "a database is defined as every page with status = open", "then": "its rows are exactly those pages, wherever they live", "source": "survey Q3: Obsidian Bases filters, Anytype Sets, Logseq property queries"}
{"id": "ref-deleting-a-view-keeps-pages", "owner": "reference", "given": "a view block showing a database", "when": "the block is removed", "then": "the database's pages are untouched", "source": "survey Q7: Anytype (deleting a query or collection never deletes objects), Obsidian (bases are views over files)"}
{"id": "ref-item-rows", "owner": "reference", "given": "Factotum tasks (items, ADR 02, not pages) labelled with a project", "when": "the project page shows a view of items with its label", "then": "it lists those tasks", "source": "Factotum ADR 02 (tasks are items), ADR 08 (one label vocabulary); Anytype Types include tasks as objects (survey Q1)"}
{"id": "factotum-concurrent-join", "owner": "factotum", "given": "two devices apart both put the same page into the same database", "when": "they sync", "then": "it is one row", "source": "ADR 01/12 per-group merge; Factotum SPEC §3.12"}
{"id": "factotum-leave-while-edited", "owner": "factotum", "given": "device A takes a page out of a database while device B edits it", "when": "they sync", "then": "it is out of the database and B's edit is kept", "source": "ADR 01 groups (labels, text apart); ADR 08 label sets merged"}
{"id": "factotum-embed-of-trashed-db", "owner": "factotum", "given": "a page embeds a database", "when": "the database is trashed", "then": "the block shows nothing (a placeholder) and the page stays", "source": "Factotum BlockType CANVAS precedent (Tendril §0.6.3: a page shown in this page, inert)"}
{"id": "factotum-one-label-vocab", "owner": "factotum", "given": "a page with a label", "when": "a database admits pages by that label", "then": "it is a row: no second tagging system", "source": "ADR 08 (one vocabulary, 'Label')"}
